HELIUS_API_KEY=your_helius_api_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
REDIS_URL=redis://localhost:6379/0
SOL_PRICE_INTERVAL=2
MCAP_THRESHOLD=8000
MCAP_ALERT_LOW=10000
MCAP_WAIT_TIMEOUT=300
CONCENTRATION_MAX_SINGLE=3.5
CONCENTRATION_MAX_TOP10=22.0
HUMAN_MIN_PERCENT=50
UNKNOWN_MAX_PERCENT=30
HELIUS_RPS=5

# 0 = free tier (logsSubscribe), 1 = Developer plan and above (transactionSubscribe)
USE_ENHANCED_WS=0
# free-tier budget for fetching buy txs; ~0.25 rps keeps you inside 1M credits/month
TX_FETCH_RPS=0.25

# on the free tier buys are sampled, so per-token buyer counts are much lower —
# set VELOCITY_MIN_BUYERS=1 there; 5 is the right value for enhanced mode
VELOCITY_MIN_BUYERS=1
VELOCITY_WINDOW=60
BUNDLE_MAX_CREATION_TXS=5
SOCIALS_REQUIRED=0
DB_PATH=screener_stats.db
